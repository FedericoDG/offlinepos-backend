      {destacadas.map((d, i) => {
        const t = tamanoPng(d.imagen);
        return (
          <section class={`section ${i === 1 ? "section-gray" : ""}`} id={d.id}>
            <div class={`shell split ${i === 1 ? "flip" : ""}`}>
              <div class="split-text">
