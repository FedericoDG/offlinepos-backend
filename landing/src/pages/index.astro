---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-aipos.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{SITIO} — {TAGLINE}</title>
    <meta
      name="description"
      content={`${SITIO} — ${TAGLINE}. ${MODULOS.join(", ")} en un solo sistema. Funciona sin internet y trae un asistente de IA que te responde en castellano.`}
    />
    <link rel="canonical" href="https://aipos.com.ar/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${SITIO} — ${TAGLINE}`} />
    <meta
      property="og:description"
      content="Vendé, cobrá y controlá tu comercio aunque se corte la conexión. Con asistente de IA integrado."
    />
    <meta property="og:image" content="https://aipos.com.ar/01.png" />
    <meta property="og:site_name" content={SITIO} />
    <meta name="author" content={EMPRESA} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="#inicio">
          <img src="/logo-aipos.png" alt="" width="24" height="24" aria-hidden="true" />
          <span>{SITIO}</span>
        </a>

        <nav class="nav-links" aria-label="Secciones">
          <a href="#beneficios">Funciones</a>
          <a href="#mostrador">El mostrador</a>
          <a href="#ia">La IA</a>
          <a href="#informe">Rentabilidad</a>
          <a href="#preguntas">Preguntas</a>
        </nav>

        <a class="btn btn-sm nav-cta" href="#demo">Pedí una demo</a>

        <details class="nav-menu">
          <summary>
            <span class="abrir">Menú</span>
            <span class="cerrar">Cerrar</span>
          </summary>
          <nav class="nav-menu-panel" aria-label="Secciones">
            <a href="#beneficios">Funciones</a>
            <a href="#mostrador">El mostrador</a>
            <a href="#ia">La IA</a>
            <a href="#informe">Rentabilidad</a>
            <a href="#preguntas">Preguntas</a>
            <a class="btn btn-sm" href="#demo">Pedí una demo</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <!-- ── Portada ─────────────────────────────────────────────────────── -->
      <section class="hero" id="inicio">
        <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker">Asistente con inteligencia artificial incluido</p>

          <h1>{CLAIM}</h1>

          <p class="hero-sub">
            El sistema completo para tu comercio: ventas, stock, compras, proveedores e informes en
            un mismo lugar. <strong>Todo en tu computadora</strong>, aunque se caiga la conexión.
          </p>

          <div class="hero-actions">
            <a class="btn" href="#demo">Pedí una demo</a>
            <a class="btn btn-outline" href="#beneficios">Ver las funciones</a>
          </div>

          <ul class="hero-facts">
            <li>Funciona sin conexión</li>
            <li>Windows</li>
            <li>Se instala en minutos</li>
          </ul>
        </div>

        <div class="hero-media">
          <Browser src="/galeria/app-01-dashboard.png" alt="Pantalla del punto de venta" eager />
        </div>
        </div>
      </section>

      <!-- ── Beneficios ──────────────────────────────────────────────────── -->
      <section class="section" id="beneficios">
        <div class="shell">
          <div class="section-head section-head-wide">
            <p class="kicker">Qué hace</p>
            <h2>Todo lo que un comercio necesita, en un solo lugar</h2>
            <p class="lead">
              Sin módulos que se cobran aparte y sin depender de que la conexión aguante.
            </p>
          </div>

          <div class="features features-two">
            {beneficios.map((b, i) => (
              <article class="feature reveal" style={`--d:${i * 50}ms`}>
                <h3>{b.titulo}</h3>
                <p>{b.texto}</p>
              </article>
            ))}
          </div>

          <div class="and-more reveal">
            <h3>Y además</h3>
            <ul class="and-more-list">
              {ademas.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ── Cómo funciona ───────────────────────────────────────────────── -->
      <section class="section section-gray" id="como-funciona">
        <div class="shell">
          <div class="section-head">
            <p class="kicker">Arrancar es simple</p>
            <h2>Tres pasos y estás vendiendo</h2>
          </div>

          <ol class="steps">
            {pasos.map((p, i) => (
              <li class="step reveal" style={`--d:${i * 60}ms`}>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ── Destacadas ──────────────────────────────────────────────────── -->
      {destacadas.map((d, i) => {
        const t = tamanoPng(d.imagen);
        return (
          <section class={`section ${i === 1 ? "section-gray" : ""}`} id={d.id}>
            <div class={`shell split ${i === 1 ? "flip" : ""}`}>
              <div class="split-text">
                <p class="kicker">{d.kicker}</p>
                <h2>{d.titulo}</h2>
                <p class="split-copy">{d.texto}</p>
                <ul class="bullets">
                  {d.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
              <div class="split-media reveal">
                <Browser
                  src={d.imagen}
                  alt={`${d.kicker}: ${d.titulo}`}
                  width={t?.width}
                  height={t?.height}
                />
              </div>
            </div>
          </section>
        );
      })}

      <!-- ── Para quién ──────────────────────────────────────────────────── -->
      <section class="section">
        <div class="shell">
          <div class="section-head">
            <p class="kicker">Para quién es</p>
            <h2>Comercios que venden en el mostrador</h2>
          </div>

          <ul class="tags">
            {publico.map((p, i) => (
              <li class="reveal" style={`--d:${i * 40}ms`}>{p}</li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ── Galería ─────────────────────────────────────────────────────── -->
      <Galeria />

      <!-- ── Preguntas ───────────────────────────────────────────────────── -->
      <section class="section" id="preguntas">
        <div class="faq-wrap">
          <p class="kicker">Preguntas frecuentes</p>
          <h2>Lo que suelen preguntar</h2>

          {preguntas.map((p, i) => (
            <details open={i === 0}>
              <summary>{p.q}</summary>
              <p>{p.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- ── Cierre ──────────────────────────────────────────────────────── -->
      <section class="cta" id="demo">
        <div class="shell">
          <p class="kicker">El próximo paso</p>
          <h2>Hablemos de tu comercio</h2>
          <p class="cta-copy">
            Te contamos qué hace el sistema, cómo se instala y cómo se carga tu catálogo. Si te
            queda alguna duda, la resolvemos ahí mismo. Sin compromiso.
          </p>
          <div class="cta-actions">
            <a class="btn btn-invert" href={WHATSAPP} target="_blank" rel="noopener"
              >Escribinos por WhatsApp</a
            >
            <a class="btn btn-outline-light" href={`mailto:${MAIL}`}>Pedir por mail</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-row">
        <div class="footer-brand">
          <a class="brand" href="#inicio">
            <img src="/logo-aipos.png" alt="" width="24" height="24" aria-hidden="true" />
            <span>{SITIO}</span>
          </a>
        </div>

        <div class="footer-col">
          <h3>Producto</h3>
          <nav class="footer-links" aria-label="Secciones">
            <a href="#beneficios">Funciones</a>
            <a href="#mostrador">El mostrador</a>
            <a href="#ia">La IA</a>
            <a href="#informe">Rentabilidad</a>
            <a href="#preguntas">Preguntas</a>
          </nav>
        </div>

        <div class="footer-col">
          <h3>Contacto</h3>
          <div class="footer-links">
            <a href={WHATSAPP} target="_blank" rel="noopener">WhatsApp</a>
            <a href={`mailto:${MAIL}`}>{MAIL}</a>
          </div>
        </div>

        <div class="footer-col">
          <h3>Empresa</h3>
          <div class="footer-links">
            <a href={WEB_EMPRESA} target="_blank" rel="noopener">{EMPRESA}</a>
          </div>
        </div>
      </div>

      <div class="footer-line">
        <img src="/logo-binario.svg" alt="" width="20" height="20" aria-hidden="true" />
        <span>
          {TAGLINE} · Una solución de{" "}
          <a href={WEB_EMPRESA} target="_blank" rel="noopener">{EMPRESA}</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      const menu = document.querySelector(".nav-menu");
      if (menu) {
        menu.querySelectorAll("a").forEach((enlace) => {
          enlace.addEventListener("click", () => {
            menu.open = false;
          });
        });
      }

      const piezas = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("in");
                observador.unobserve(entrada.target);
              }
            }
          },
          { rootMargin: "0px 0px -6% 0px", threshold: 0.08 },
        );
        piezas.forEach((pieza) => observador.observe(pieza));
      } else {
        piezas.forEach((pieza) => pieza.classList.add("in"));
      }
    </script>
  </body>
</html>
