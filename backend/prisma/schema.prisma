// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
}

model Administrador {
  id       String @id @default(uuid())
  email    String @unique
  password String
  rol      Rol    @default(ADMINISTRADOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comercio {
  id        String     @id @default(uuid())
  nombre    String
  licencias Licencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RolLicencia {
  SERVIDOR
  CLIENTE
}

model Licencia {
  id               String       @id @default(uuid())
  comercio_id      String
  comercio         Comercio     @relation(fields: [comercio_id], references: [id], onDelete: Cascade)
  clave_hash       String
  rol              RolLicencia  @default(SERVIDOR)
  estado           String       @default("activa")
  activado_en      DateTime?
  max_activaciones Int          @default(1)
  activaciones     Activacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activacion {
  id                String   @id @default(uuid())
  licencia_id       String
  licencia          Licencia @relation(fields: [licencia_id], references: [id], onDelete: Cascade)
  instalacion_id    String
  ultima_validacion DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([licencia_id, instalacion_id])
}
