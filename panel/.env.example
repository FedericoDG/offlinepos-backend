# URL del backend Express. El panel le pega desde el servidor de Next
# (server actions y server components), nunca desde el navegador: por eso
# no hace falta tocar CORS_ORIGIN en el backend.
BACKEND_URL="http://localhost:4000"

# Nombre de la cookie de sesion del panel. La cookie es httpOnly y guarda el
# JWT que devuelve el backend; el token nunca queda expuesto al JavaScript
# del navegador.
SESSION_COOKIE_NAME="binario_panel_session"
