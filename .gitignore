.env
# Versiones publicadas del POS (instaladores + latest.json): pesan decenas
# de MB y se generan al publicar desde el panel, no se versionan.
updates/

# Archivos reales de produccion en el VPS (nunca en el repo).
deploy/env/
deploy/.env

# Índice local de CodeGraph (herramienta de análisis)
.codegraph/

# Salida compilada: se genera al build, no se versiona.
backend/dist/

# Capturas y reportes del skill de diseno (artefactos, no fuente)
landing/.taste-skill/
