---
/**
 * Miniatura de la galería.
 *
 * Es un enlace real a la imagen completa: sin JavaScript, tocarla abre el PNG
 * en el navegador. Con JavaScript, el visor la intercepta y la muestra en
 * grande.
 */
import type { ImagenGaleria } from "../lib/galeria";

interface Props {
  imagen: ImagenGaleria;
  indice: number;
  /** Retraso de la animación de aparición, en milisegundos. */
  retraso?: number;
}

const { imagen, indice, retraso = 0 } = Astro.props;
---

<a
  class="shot reveal"
  href={imagen.src}
  data-galeria-item
  data-indice={indice}
  data-etiqueta={imagen.etiqueta}
  style={`--d:${retraso}ms`}
>
  <span class="shot-media">
    <img
      src={imagen.src}
      alt={imagen.alt}
      width="1600"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="shot-label">
    <span class="shot-name">{imagen.etiqueta}</span>
    <span class="shot-group">{imagen.grupo}</span>
  </span>
</a>

<style>
  .shot {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .shot-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .shot-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .shot:hover .shot-media {
    transform: translateY(-2px);
    border-color: #cfe0e7;
    box-shadow: 0 14px 28px -18px rgba(18, 101, 138, 0.4);
  }

  .shot:hover .shot-media img {
    transform: scale(1.015);
  }

  .shot:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 4px;
    border-radius: 10px;
  }

  .shot-label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 8px;
    margin-top: 8px;
    font-size: var(--t-small);
  }

  .shot-name {
    color: var(--ink);
    font-weight: 600;
  }

  .shot-group {
    color: var(--gray);
    font-size: var(--t-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot-media,
    .shot-media img {
      transition: none;
    }

    .shot:hover .shot-media,
    .shot:hover .shot-media img {
      transform: none;
    }
  }
</style>
