// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
}

model Administrador {
  id       String @id @default(uuid())
  email    String @unique
  password String
  rol      Rol    @default(ADMINISTRADOR)
  /// Baja logica: un administrador desactivado no puede iniciar sesion y su
  /// token vivo deja de servir (el middleware re-chequea este campo).
  activo   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comercio {
  id        String     @id @default(uuid())
  nombre    String
  /// Datos de contacto del comercio. Opcionales: un comercio puede existir sin
  /// telefono ni email cargados (alta rapida, datos que se completan despues).
  telefono  String?
  email     String?
  /// Override por comercio del cupo de Binny. null = usa el plan / env; 0 = ilimitado solo para este comercio.
  chat_mensajes_override Int?
  /// Plan asignado directo al comercio (alta en un paso). Opcional: si el
  /// comercio sigue el camino viejo, vive solo su Suscripcion y aca es null.
  plan_id String?
  licencias     Licencia[]
  /// Consumo de Binny a nivel comercio: el cupo es del comercio y se comparte
  /// entre todas sus claves. Una fila por comercio + periodo.
  chatConsumosComercio ChatConsumoComercio[]
  suscripciones Suscripcion[]
  /// Pagos directos del comercio, sin Suscripcion de por medio (camino nuevo).
  pagos         Pago[]
  plan          Plan?       @relation(fields: [plan_id], references: [id], onDelete: SetNull)

  @@index([plan_id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RolLicencia {
  SERVIDOR
}

model Licencia {
  id               String       @id @default(uuid())
  /// Null = la clave todavía no está asignada a ningún comercio ("libre").
  /// Se genera suelta y recién se asigna al dar de alta un comercio.
  comercio_id      String?
  comercio         Comercio?    @relation(fields: [comercio_id], references: [id], onDelete: SetNull)
  clave_hash       String
  clave_busqueda   String?        @unique
  rol              RolLicencia  @default(SERVIDOR)
  estado           String       @default("activa")
  activado_en      DateTime?
  max_activaciones Int          @default(1)
  activaciones     Activacion[]
  chatConsumos     ChatConsumo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activacion {
  id                String   @id @default(uuid())
  licencia_id       String
  licencia          Licencia @relation(fields: [licencia_id], references: [id], onDelete: Cascade)
  instalacion_id    String
  ultima_validacion DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([licencia_id, instalacion_id])
}

model ChatConsumo {
  id                String   @id @default(uuid())
  licencia_id       String
  licencia          Licencia @relation(fields: [licencia_id], references: [id], onDelete: Cascade)
  periodo           String   // "2026-09"
  mensajes          Int      @default(0)
  prompt_tokens     BigInt   @default(0)
  completion_tokens BigInt   @default(0)
  total_tokens      BigInt   @default(0)
  cached_tokens     BigInt   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([licencia_id, periodo])
}

/// Contador de mensajes de Binny a nivel comercio. El cupo se comparte entre
/// todas las licencias del comercio: 2 claves con cupo 600 consumen 600 en
/// total, no 600 cada una. La fila por licencia (ChatConsumo) se conserva solo
/// como desglose de estadisticas y para los contadores de tokens.
model ChatConsumoComercio {
  id          String   @id @default(uuid())
  comercio_id String
  comercio    Comercio @relation(fields: [comercio_id], references: [id], onDelete: Cascade)
  periodo     String   // "2026-09"
  mensajes    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([comercio_id, periodo])
  @@map("chat_consumo_comercio")
}


// ============================================================================
// Panel de administracion — Binario Dev Labs
// Todo lo de abajo es agregado: planes comerciales, la suscripcion que cada
// comercio tiene contratada y los pagos que la sostienen. Los modelos de
// arriba (Administrador, Comercio, Licencia, Activacion) no cambian: la
// licencia sigue siendo la llave tecnica que activa una instalacion, y la
// suscripcion es el contrato comercial que la habilita a seguir viva.
// ============================================================================

enum CicloFacturacion {
  MENSUAL
  ANUAL
}

/// Tipo de suscripcion vendible. Arranca con dos filas (BASICO y PRO) que el
/// panel puede editar, pero es una tabla y no un enum a proposito: cambiar un
/// precio no puede exigir una migracion.
model Plan {
  id             String   @id @default(uuid())
  codigo         String   @unique
  nombre         String
  descripcion    String?
  precio_mensual Decimal  @db.Decimal(12, 2)
  precio_anual   Decimal? @db.Decimal(12, 2)
  moneda         String   @default("ARS")
  /// Cupo de licencias con rol SERVIDOR que habilita el plan.
  max_servidores Int      @default(1)
  /// Mensajes mensuales del chat. 0 = ilimitado.
  chat_mensajes_mes Int  @default(400)
  /// Baja logica. Un plan discontinuado deja de ofrecerse pero las
  /// suscripciones que ya lo tienen contratado siguen funcionando.
  activo         Boolean  @default(true)

  suscripciones Suscripcion[]
  /// Comercios que tienen este plan asignado directo, sin suscripcion de por medio.
  comercios Comercio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoSuscripcion {
  ACTIVA
  EN_GRACIA
  VENCIDA
  CANCELADA
}

model Suscripcion {
  id          String   @id @default(uuid())
  comercio_id String
  comercio    Comercio @relation(fields: [comercio_id], references: [id], onDelete: Cascade)
  plan_id     String
  /// Restrict: un plan con suscripciones vivas no se puede borrar por error.
  plan        Plan     @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  estado EstadoSuscripcion @default(ACTIVA)
  ciclo  CicloFacturacion  @default(MENSUAL)

  /// Se copia del plan al contratar y despues vive por su cuenta: subir la
  /// lista de precios no debe cambiarle el precio a quien ya firmo.
  precio_pactado Decimal @db.Decimal(12, 2)
  moneda         String  @default("ARS")

  inicia_en    DateTime  @default(now())
  vence_en     DateTime
  cancelada_en DateTime?
  nota         String?

  pagos Pago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vence_en])
  @@index([comercio_id])
  @@index([estado])
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
  TARJETA
  OTRO
}

model Pago {
  id             String       @id @default(uuid())
  /// Camino viejo: el pago cuelga de una Suscripcion. Queda nullable para
  /// convivir con los pagos directos, que cuelgan del Comercio.
  suscripcion_id String?
  suscripcion    Suscripcion? @relation(fields: [suscripcion_id], references: [id], onDelete: Cascade)

  /// Camino nuevo: pago directo del comercio (sin Suscripcion). Cascade: dar de
  /// baja un comercio se lleva sus pagos, que no tienen sentido sin el.
  comercio_id String?
  comercio    Comercio? @relation(fields: [comercio_id], references: [id], onDelete: Cascade)

  monto  Decimal    @db.Decimal(12, 2)
  moneda String     @default("ARS")
  metodo MetodoPago @default(TRANSFERENCIA)

  /// Fecha en que entro la plata. Es la que manda en el grafico de ingreso
  /// mensual: un pago de marzo cobrado en abril suma en abril.
  pagado_en DateTime @default(now())

  /// Periodo que cubre el pago. Sirve para detectar meses sin cobrar.
  periodo_desde DateTime
  periodo_hasta DateTime

  referencia String?
  nota       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pagado_en])
  @@index([suscripcion_id])
  @@index([comercio_id])
}
