---
/**
 * Galería: todas las pantallas del sistema en una grilla limpia.
 *
 * La lista sale de `public/galeria/` (ver `src/lib/galeria.ts`), así que agregar
 * o sacar una captura no pide tocar este archivo. Sin JavaScript cada miniatura
 * sigue siendo un enlace real a la imagen completa.
 */
import { listarGaleria } from "../lib/galeria";
import GaleriaItem from "./GaleriaItem.astro";
import GaleriaLightbox from "./GaleriaLightbox.astro";

const imagenes = listarGaleria();

if (imagenes.length === 0) {
  console.warn("[galeria] la sección quedó sin capturas: revisá public/galeria/");
}
---

{
  imagenes.length > 0 && (
    <section class="section section-gray" id="galeria" data-galeria>
      <div class="shell">
        <div class="section-head">
          <p class="kicker reveal">Galería</p>
          <h2 class="reveal">Mirá el sistema por dentro</h2>
          <p class="lead reveal" style="--d:70ms">
            Un recorrido por las pantallas principales, con capturas del sistema en uso. Tocá
            cualquiera para verla en grande y pasar a la siguiente.
          </p>
        </div>

        <div class="gallery-grid">
          {imagenes.map((imagen, i) => (
            <GaleriaItem imagen={imagen} indice={i} retraso={(i % 5) * 40} />
          ))}
        </div>
      </div>

      <GaleriaLightbox />
    </section>
  )
}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 28px 16px;
  }

  @media (max-width: 1100px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  const raiz = document.querySelector("[data-galeria]");
  const visor = raiz?.querySelector("[data-visor]");

  if (raiz && visor) {
    const anclas = Array.from(raiz.querySelectorAll("[data-galeria-item]"));
    const imagen = visor.querySelector("[data-visor-imagen]");
    const etiqueta = visor.querySelector("[data-visor-etiqueta]");
    const contador = visor.querySelector("[data-visor-contador]");
    const cerrarBoton = visor.querySelector("[data-visor-cerrar]");
    const botones = Array.from(visor.querySelectorAll("button"));

    const capturas = anclas.map((a) => ({
      src: a.getAttribute("href") ?? "",
      etiqueta: a.dataset.etiqueta ?? "",
      alt: a.querySelector("img")?.alt ?? "",
    }));

    let indice = 0;
    let focoPrevio = null;

    /** Adelanta la descarga de las vecinas para que el salto se sienta instantáneo. */
    function precargar(i) {
      const captura = capturas[(i + capturas.length) % capturas.length];
      if (!captura) return;
      const img = new Image();
      img.src = captura.src;
    }

    /** Muestra la captura `i`, dando la vuelta en los extremos. */
    function pintar(i) {
      indice = (i + capturas.length) % capturas.length;
      const captura = capturas[indice];
      if (!captura) return;
      imagen.src = captura.src;
      imagen.alt = captura.alt;
      etiqueta.textContent = captura.etiqueta;
      contador.textContent = `${indice + 1} / ${capturas.length}`;
      precargar(indice + 1);
      precargar(indice - 1);
    }

    function abrir(i, disparador) {
      focoPrevio = disparador;
      pintar(i);
      visor.hidden = false;
      document.documentElement.classList.add("visor-abierto");
      cerrarBoton.focus();
    }

    function cerrar() {
      visor.hidden = true;
      document.documentElement.classList.remove("visor-abierto");
      imagen.removeAttribute("src");
      if (focoPrevio instanceof HTMLElement) focoPrevio.focus();
    }

    anclas.forEach((ancla, i) => {
      ancla.addEventListener("click", (e) => {
        // Sin JavaScript el enlace abre la imagen original: el visor es una mejora.
        e.preventDefault();
        abrir(i, ancla);
      });
    });

    visor.querySelector("[data-visor-anterior]")?.addEventListener("click", () => pintar(indice - 1));
    visor.querySelector("[data-visor-siguiente]")?.addEventListener("click", () => pintar(indice + 1));
    cerrarBoton?.addEventListener("click", cerrar);

    // Un clic en el fondo oscurecido cierra; sobre la imagen o un botón, no.
    visor.addEventListener("click", (e) => {
      const objetivo = e.target;
      if (!(objetivo instanceof Element)) return;
      if (objetivo.closest("[data-visor-caja]") || objetivo.closest("button")) return;
      cerrar();
    });

    document.addEventListener("keydown", (e) => {
      if (visor.hidden) return;

      if (e.key === "Escape") {
        cerrar();
      } else if (e.key === "ArrowLeft") {
        pintar(indice - 1);
      } else if (e.key === "ArrowRight") {
        pintar(indice + 1);
      } else if (e.key === "Tab") {
        // El foco queda encerrado en el visor mientras está abierto.
        const primero = botones[0];
        const ultimo = botones[botones.length - 1];
        if (!primero || !ultimo) return;
        if (e.shiftKey && document.activeElement === primero) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    });

    // Deslizar el dedo para pasar de pantalla en pantallas táctiles.
    let toqueX = 0;
    let toqueY = 0;

    visor.addEventListener(
      "touchstart",
      (e) => {
        toqueX = e.changedTouches[0].clientX;
        toqueY = e.changedTouches[0].clientY;
      },
      { passive: true },
    );

    visor.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - toqueX;
        const dy = e.changedTouches[0].clientY - toqueY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
          pintar(indice + (dx < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );
  }
</script>
