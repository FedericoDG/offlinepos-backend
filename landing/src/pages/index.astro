/** Ancho y alto reales de un PNG de `public/`, leídos del encabezado IHDR. */
function tamanoPng(rutaPublica: string): { width: number; height: number } | null {
  if (!rutaPublica.endsWith(".png")) return null;
  const ruta = path.join(process.cwd(), "public", rutaPublica.replace(/^\//, ""));
  try {
    const buf = fs.readFileSync(ruta);
    return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
  } catch {
    console.warn(`[landing] no se pudo leer el tamaño de ${rutaPublica}`);
    return null;
  }
}

