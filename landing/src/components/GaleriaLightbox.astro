---
/**
 * Visor de la galería: la captura en grande sobre todo lo demás.
 *
 * Arranca `hidden` y sin foco. El comportamiento (abrir, cerrar, siguiente,
 * anterior, teclado, gestos) vive en el script de `Galeria.astro`, que es su
 * único consumidor.
 */
---

<div
  class="visor"
  data-visor
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Galería de pantallas"
>
  <button class="visor-boton visor-cerrar" data-visor-cerrar type="button" aria-label="Cerrar la galería">
    <svg width="17" height="17" viewBox="0 0 18 18" aria-hidden="true">
      <path d="M3 3l12 12M15 3L3 15" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>

  <button
    class="visor-boton visor-nav visor-anterior"
    data-visor-anterior
    type="button"
    aria-label="Pantalla anterior"
  >
    <span aria-hidden="true">←</span>
  </button>

  <figure class="visor-caja" data-visor-caja>
    <img class="visor-imagen" data-visor-imagen alt="" width="1600" height="1000" decoding="async" />
    <figcaption class="visor-pie">
      <span class="visor-etiqueta" data-visor-etiqueta></span>
      <span class="visor-contador" data-visor-contador></span>
    </figcaption>
  </figure>

  <button
    class="visor-boton visor-nav visor-siguiente"
    data-visor-siguiente
    type="button"
    aria-label="Pantalla siguiente"
  >
    <span aria-hidden="true">→</span>
  </button>
</div>

<style>
  .visor {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(8px, 2vw, 24px);
    padding: clamp(64px, 8vh, 88px) clamp(16px, 4vw, 56px) clamp(24px, 5vh, 48px);
    background: rgba(9, 38, 48, 0.95);
  }

  .visor[hidden] {
    display: none;
  }

  .visor-caja {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 0;
    min-width: 0;
  }

  .visor-imagen {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100vh - 210px);
    border-radius: 10px;
  }

  .visor-pie {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--t-small);
    color: #fff;
  }

  .visor-etiqueta {
    font-weight: 500;
  }

  .visor-contador {
    color: rgba(255, 255, 255, 0.62);
    font-variant-numeric: tabular-nums;
  }

  .visor-boton {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .visor-boton:hover,
  .visor-boton:focus-visible {
    background: rgba(255, 255, 255, 0.26);
  }

  .visor-boton:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .visor-cerrar {
    position: fixed;
    top: clamp(14px, 3vh, 26px);
    right: clamp(14px, 3vw, 30px);
    z-index: 1;
  }

  @media (max-width: 700px) {
    .visor {
      grid-template-columns: minmax(0, 1fr);
      padding: 66px 12px 92px;
      align-content: center;
    }

    .visor-nav {
      position: fixed;
      bottom: 20px;
    }

    .visor-anterior {
      left: 20px;
    }

    .visor-siguiente {
      right: 20px;
    }

    .visor-imagen {
      max-height: calc(100vh - 250px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .visor-boton {
      transition: none;
    }
  }
</style>
