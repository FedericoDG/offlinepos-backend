/**
 * Landing de AIPOS — el punto de venta que funciona sin internet.
 *
 * Sitio 100% estático: una sola página, sin frameworks ni dependencias de npm.
 * El JavaScript son tres piezas chicas y sin dependencias: el observador de
 * scroll que hace aparecer las secciones, el visor de la galería y el menú
 * hamburguesa de pantallas chicas.
 *
 * Publicación: el dominio (https://aipos.com.ar/) y la imagen de compartir ya
 * están definidos en el <head>. Si querés una tarjeta propia de 1200x630 para
 * cuando compartan el link, es el `og:image`.
 */
import fs from "node:fs";
import path from "node:path";
import Galeria from "../components/Galeria.astro";

/**
 * Ancho y alto reales de un PNG de `public/`, leídos del encabezado IHDR.
 *
 * Las imágenes DEBEN declarar su tamaño: sin eso el navegador no reserva el
 * espacio, la página se estira al cargarlas y los anclajes del menú quedan
 * cortos (la sección se corre hacia abajo después de que ya te llevó).
 * Se lee del archivo y no se escribe a mano, así sigue siendo correcto si
 * cambiás una imagen por otra de otro tamaño.
 */
function tamanoPng(rutaPublica: string): { width: number; height: number } | null {
  if (!rutaPublica.endsWith(".png")) return null;
  const ruta = path.join(process.cwd(), "public", rutaPublica.replace(/^\//, ""));
  try {
    const buf = fs.readFileSync(ruta);
    return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
  } catch {
    console.warn(`[landing] no se pudo leer el tamaño de ${rutaPublica}`);
    return null;
  }
}

