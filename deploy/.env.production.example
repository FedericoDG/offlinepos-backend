# EJEMPLO de variables de produccion — POS offline (backend + panel).
# ---------------------------------------------------------------------------
# Este archivo NO se usa directamente: es la plantilla para crear, EN EL VPS,
# los dos archivos reales (con valores verdaderos, nunca en el repo):
#
#   /root/apps/offlinepos/deploy/env/backend.env   <- seccion BACKEND (abajo)
#   /root/apps/offlinepos/deploy/env/panel.env     <- seccion PANEL (abajo)
#
# Esos archivos estan ignorados por git (ver .gitignore: deploy/env/).
# BACKEND_URL no es confidencial y ya va fijo en compose.prod.yml
# (http://panel-backend:4000); solo se lista aqui como referencia.
#
# Cada variable corresponde a backend/src/config/env.ts (validadas con zod:
# si falta una obligatoria el backend no arranca) o al panel
# (panel/src/lib/api.ts, panel/src/lib/sesion.ts, panel/src/proxy.ts).
# Comentarios en español: que es cada valor y que poner en produccion.
# Nota: la migracion 20261007120000 elimina licencias CLIENTE: confirma que
# DATABASE_URL apunte a la base de produccion antes del primer despliegue.
# ---------------------------------------------------------------------------

# ============================ BACKEND (backend.env) =========================
# --- Conexion a Neon (Postgres gestionado). Obligatoria. ---
# Formato Neon con TLS exigido. Reemplaza usuario, clave, host y base.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# --- Puerto interno del backend (solo red vps-net, nginx proxea). ---
# Valor por defecto del codigo: 4000. Debe coincidir con compose.prod.yml.
PORT=4000
# --- Entorno: production en el VPS. ---
NODE_ENV=production

# --- Clave para firmar los JWT de sesion del panel. Obligatoria. ---
# Genera un valor largo y aleatorio (ej. `openssl rand -hex 48`).
# Si cambia, todas las sesiones abiertas se invalidan.
JWT_SECRET=<REPLACE_ME_GENERA_UN_VALOR_LARGO_Y_ALEATORIO>
# --- Duracion del token de acceso (ej. 15m, 1h, 7d). Obligatoria. ---
JWT_AT_EXPIRY=15m

# --- Clave AES-256 para cifrar datos guardados (minimo 32 caracteres). ---
# Opcional (trae valor de desarrollo por defecto): en produccion define una
# propia y no la cambies jamas (los datos ya cifrados serian ilegibles).
ENCRYPTION_KEY=<REPLACE_ME_MINIMO_32_CARACTERES_ALEATORIOS>
# --- Clave para el indice de busqueda de licencias. Opcional. ---
# Si se omite usa ENCRYPTION_KEY. Solo definela si quieres rotarla aparte.
# LOOKUP_SECRET=<REPLACE_ME_OPCIONAL>

# --- Origenes permitidos para CORS (dominio del panel). ---
# Lista separada por comas. Ajusta al hostname real del panel.
CORS_ORIGIN=https://pospanel-binario.duckdns.org

# --- Proveedor de IA para el chat (compatible OpenAI). ---
# URL base del servicio (por defecto DashScope). Obligatoria solo si usas chat.
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# --- Clave del proveedor de IA. Obligatoria (el chat no anda sin ella). ---
LLM_API_KEY=<REPLACE_ME_CLAVE_DEL_PROVEEDOR_DE_IA>
# --- Modelo de chat por defecto. ---
LLM_MODEL=qwen3.7-flash
# --- Modelo mayor para analisis profundos. Opcional (si se omite todo usa LLM_MODEL). ---
# LLM_MODEL_PRO=<REPLACE_ME_OPCIONAL>
# --- Modelo de vision para imagenes. ---
LLM_VISION_MODEL=qwen-vl-plus
# --- Activa razonamiento extendido del modelo (true/false). ---
LLM_ENABLE_THINKING=false
# --- Cuota mensual de mensajes de IA por comercio. ---
CHAT_MENSAJES_MES=400
# --- Mensajes que consume cada OCR procesado. ---
CHAT_MENSAJES_POR_OCR=10

# --- Clave privada Ed25519 (PEM) para firmar licencias. Opcional en dev. ---
# En produccion sin esta clave, activar una licencia falla. Generala con
# `npm run licencia:generar-claves` en backend/ y pega el PEM completo
# (multilinea entre comillas) o su contenido en una linea.
# LICENCIA_SIGN_PRIV_KEY=<REPLACE_ME_PEM_ED25519_OPCIONAL>

# --- URL publica del backend (la ven los POS al descargar updates). ---
# Ajusta al hostname real de la API.
PUBLIC_BASE_URL=https://posapi-binario.duckdns.org

# --- Dias extra tras el vencimiento antes de cortar el servicio. Opcional. ---
# Si se omite el codigo usa 3.
# DIAS_GRACIA=3

# ============================== PANEL (panel.env) ===========================
# --- Nombre de la cookie de sesion del panel. ---
# Debe ser el mismo valor que espera el codigo (por defecto
# binario_panel_session). Cambialo solo si quieres personalizarlo.
SESSION_COOKIE_NAME=binario_panel_session
# --- Referencia (NO va en panel.env: ya esta fija en compose.prod.yml). ---
# BACKEND_URL=http://panel-backend:4000
